    "@fastify/multipart": "^10.1.2",
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.12.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
