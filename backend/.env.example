# Local settings (copy to .env and replace placeholders for /me)
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# /me uses a publishable key with a caller's Bearer user token, never a service role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY
# Server-only spot writes; prefer a new-format secret key. Never prefix with VITE_.
# SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET
# Legacy fallback only if it is a genuine unexpired Supabase service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_GENUINE_SERVER_ONLY_SERVICE_ROLE_JWT

# Planned local text encoder; not loaded or downloaded by this scaffold
MODEL_ID=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=.cache/models
